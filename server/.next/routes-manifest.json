    },
    {
      "page": "/distributie-b2b",
      "regex": "^/distributie\\-b2b(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/distributie\\-b2b(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/politica-de-confidentialitate",
      "regex": "^/politica\\-de\\-confidentialitate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/politica\\-de\\-confidentialitate(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
